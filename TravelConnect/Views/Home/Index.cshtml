@{
    ViewData["Title"] = "Trang chủ";
}

<!-- HERO -->
<section class="hero">
    <div class="hero-overlay">
        <div class="container hero-content">

            <span class="hero-subtitle">KHÁM PHÁ • KẾT NỐI • TRẢI NGHIỆM</span>

            <h1>
                Khám phá Việt Nam<br />
                theo cách của bạn
            </h1>

            <p>
                Tìm những địa điểm tuyệt vời, chia sẻ trải nghiệm
                và tạo lịch trình du lịch phù hợp với bạn.
            </p>

            <!-- SEARCH -->
            <div class="travel-search">

                <div class="search-item">
                    <span>📍</span>
                    <div>
                        <small>Đi đâu?</small>
                        <input type="text" placeholder="Bạn muốn đi đâu?" />
                    </div>
                </div>

                <div class="search-item">
                    <span>📅</span>
                    <div>
                        <small>Thời gian</small>
                        <input type="text" placeholder="Chọn thời gian" />
                    </div>
                </div>

                <div class="search-item">
                    <span>❤️</span>
                    <div>
                        <small>Sở thích</small>
                        <input type="text" placeholder="Biển, núi, ẩm thực..." />
                    </div>
                </div>

                <button class="search-submit">
                    🔍 Tìm kiếm
                </button>

            </div>

        </div>
    </div>
</section>


<!-- POPULAR DESTINATIONS -->
<section class="section">
    <div class="container">

        <div class="section-heading">
            <div>
                <span class="section-label">KHÁM PHÁ</span>
                <h2>Địa điểm nổi bật</h2>
            </div>

            <a href="#" class="view-more">
                Xem tất cả →
            </a>
        </div>


        <div class="destination-grid">

            <div class="destination-card">
                <div class="destination-image da-nang">
                    <span class="destination-tag">Miền Trung</span>
                </div>

                <div class="destination-info">
                    <h3>Đà Nẵng</h3>
                    <p>🌊 Biển • 🏔️ Núi • 🍜 Ẩm thực</p>
                    <span>⭐ 4.8</span>
                </div>
            </div>


            <div class="destination-card">
                <div class="destination-image da-lat">
                    <span class="destination-tag">Tây Nguyên</span>
                </div>

                <div class="destination-info">
                    <h3>Đà Lạt</h3>
                    <p>🌲 Thiên nhiên • ☕ Cà phê • 📸 Check-in</p>
                    <span>⭐ 4.7</span>
                </div>
            </div>


            <div class="destination-card">
                <div class="destination-image ha-long">
                    <span class="destination-tag">Miền Bắc</span>
                </div>

                <div class="destination-info">
                    <h3>Hạ Long</h3>
                    <p>🌊 Vịnh biển • 🚢 Du thuyền • 🏝️ Đảo</p>
                    <span>⭐ 4.9</span>
                </div>
            </div>

        </div>

    </div>
</section>


<!-- AI SECTION -->
<section class="ai-section">
    <div class="container">

        <div class="ai-box">

            <div class="ai-content">

                <span class="section-label">✨ TRAVELCONNECT AI</span>

                <h2>
                    Không biết đi đâu?<br />
                    Để AI lên lịch cho bạn.
                </h2>

                <p>
                    Cho chúng tôi biết bạn muốn đi đâu, trong bao lâu
                    và yêu thích điều gì. AI sẽ gợi ý địa điểm và
                    xây dựng lịch trình phù hợp.
                </p>

                <a href="#" class="ai-button">
                    ✨ Tạo lịch trình với AI
                </a>

            </div>

            <div class="ai-icon">
                ✈️
            </div>

        </div>

    </div>
</section>


<!-- COMMUNITY -->
<section class="section community-section">
    <div class="container">

        <div class="section-heading">
            <div>
                <span class="section-label">CỘNG ĐỒNG</span>
                <h2>Chia sẻ từ những người yêu du lịch</h2>
            </div>

            <a href="#" class="view-more">
                Xem cộng đồng →
            </a>
        </div>


        <div class="post-grid">

            <article class="post-card">
                <div class="post-placeholder">📸</div>
                <div class="post-content">
                    <span>Đà Lạt</span>
                    <h3>3 ngày 2 đêm ở thành phố ngàn hoa</h3>
                    <p>
                        Một chuyến đi nhẹ nhàng cùng những địa điểm
                        không thể bỏ qua...
                    </p>
                    <small>👤 Thành viên TravelConnect</small>
                </div>
            </article>


            <article class="post-card">
                <div class="post-placeholder">🏝️</div>
                <div class="post-content">
                    <span>Phú Quốc</span>
                    <h3>Kinh nghiệm du lịch Phú Quốc tự túc</h3>
                    <p>
                        Tổng hợp những địa điểm, món ăn và kinh nghiệm
                        cho chuyến đi...
                    </p>
                    <small>👤 Thành viên TravelConnect</small>
                </div>
            </article>


            <article class="post-card">
                <div class="post-placeholder">⛰️</div>
                <div class="post-content">
                    <span>Sapa</span>
                    <h3>Khám phá Sapa mùa lúa chín</h3>
                    <p>
                        Những góc check-in đẹp và lịch trình tham khảo
                        cho chuyến đi...
                    </p>
                    <small>👤 Thành viên TravelConnect</small>
                </div>
            </article>

        </div>

    </div>
</section>