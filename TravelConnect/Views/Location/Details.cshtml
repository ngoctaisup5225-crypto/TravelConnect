@model TravelConnect.Models.Location

@{
    ViewData["Title"] = Model.Name;
}

<!-- LOCATION DETAIL -->

<section class="detail-page">

    <div class="container">

        <!-- BREADCRUMB -->
        <div class="breadcrumb-custom">

            <a asp-controller="Home"
               asp-action="Index">
                Trang chủ
            </a>

            <span>›</span>

            <a asp-controller="Location"
               asp-action="Index">
                Địa điểm
            </a>

            <span>›</span>

            <span>@Model.Name</span>

        </div>


        <!-- HERO IMAGE -->

        <div class="detail-image">

            <img src="@Model.Image"
                 alt="@Model.Name" />

            <!-- CATEGORY -->

            <span class="detail-category">
                @Model.Category
            </span>


            <!-- FAVORITE BUTTON -->

            <a asp-controller="Favorite"
               asp-action="Add"
               asp-route-id="@Model.Id"
               asp-route-name="@Model.Name"
               asp-route-province="@Model.Province"
               asp-route-image="@Model.Image"
               asp-route-rating="@Model.Rating"
               class="detail-favorite">

                ❤️ Lưu địa điểm

            </a>

        </div>


        <!-- INFORMATION -->

        <div class="detail-content">


            <!-- MAIN CONTENT -->

            <div class="detail-main">

                <span class="section-label">
                    @Model.Category.ToUpper()
                </span>


                <h1>
                    @Model.Name
                </h1>


                <!-- META -->

                <div class="detail-meta">

                    <span>
                        📍 @Model.Province
                    </span>

                    <span>
                        ⭐ @Model.Rating / 5
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <p class="detail-description">
                    @Model.Description
                </p>


                <!-- INTRODUCTION -->

                <h2>
                    Giới thiệu
                </h2>


                <p>
                    @Model.Name là một trong những điểm đến được
                    nhiều du khách yêu thích tại Việt Nam. Nơi đây
                    mang đến nhiều trải nghiệm thú vị, phù hợp cho
                    những chuyến đi cùng gia đình, bạn bè hoặc hành
                    trình khám phá cá nhân.
                </p>


                <p>
                    Du khách có thể khám phá cảnh quan thiên nhiên,
                    thưởng thức ẩm thực địa phương và tìm hiểu văn
                    hóa đặc trưng của vùng đất này.
                </p>


                <p>
                    Với cảnh quan đặc sắc và nhiều hoạt động hấp dẫn,
                    @Model.Name là một lựa chọn phù hợp cho những
                    chuyến du lịch và khám phá.
                </p>

            </div>


            <!-- SIDEBAR -->

            <aside class="detail-sidebar">


                <!-- ACTION BOX -->

                <div class="action-box">

                    <h3>
                        Lên kế hoạch chuyến đi
                    </h3>


                    <p>
                        Thêm địa điểm này vào lịch trình của bạn.
                    </p>


                    <!-- ADD TO ITINERARY -->

                    <a asp-controller="Itinerary"
                       asp-action="Index"
                       class="primary-action">

                        🗓️ Thêm vào lịch trình

                    </a>


                    <!-- FAVORITE -->

                    <a asp-controller="Favorite"
                       asp-action="Add"
                       asp-route-id="@Model.Id"
                       asp-route-name="@Model.Name"
                       asp-route-province="@Model.Province"
                       asp-route-image="@Model.Image"
                       asp-route-rating="@Model.Rating"
                       class="secondary-action">

                        ❤️ Lưu địa điểm

                    </a>

                </div>


                <!-- RATING BOX -->

                <div class="rating-box">

                    <span class="big-rating">
                        @Model.Rating
                    </span>


                    <div>

                        <div>
                            ⭐⭐⭐⭐⭐
                        </div>

                        <p>
                            Đánh giá từ cộng đồng
                        </p>

                    </div>

                </div>


                <!-- LOCATION INFO -->

                <div class="location-info-box">

                    <h3>
                        Thông tin
                    </h3>


                    <div class="info-row">

                        <span>
                            📍 Tỉnh / Thành
                        </span>

                        <strong>
                            @Model.Province
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            🏷️ Loại hình
                        </span>

                        <strong>
                            @Model.Category
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            ⭐ Đánh giá
                        </span>

                        <strong>
                            @Model.Rating / 5
                        </strong>

                    </div>

                </div>

            </aside>

        </div>

    </div>

</section>