@{
    ViewData["Title"] = "AI du lịch";
}

<section class="ai-page">

    <div class="ai-container">


        <!-- =========================
             HEADER
             ========================= -->

        <div class="ai-hero">

            <div class="ai-icon">
                ✨
            </div>

            <span class="ai-label">
                TRAVELCONNECT AI
            </span>

            <h1>
                Trợ lý du lịch AI
            </h1>

            <p>
                Nhập thông tin chuyến đi của bạn.
                Hệ thống sẽ phân tích và gợi ý những
                địa điểm phù hợp.
            </p>

        </div>


        <!-- =========================
             ERROR
             ========================= -->
        @if (ViewBag.Error != null)
        {
            <div class="ai-error">
                ⚠️ @ViewBag.Error
            </div>
        }


        <!-- =========================
             FORM
             ========================= -->

        <div class="ai-form-card">

            <form asp-controller="AI"
                  asp-action="Recommend"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- ĐIỂM ĐẾN -->

                <div class="ai-form-group">

                    <label>
                        📍 Bạn muốn đi đâu?
                    </label>

                    <input type="text"
                           name="destination"
                           placeholder="Ví dụ: Đà Nẵng, Đà Lạt, Hội An..." />

                </div>


                <!-- SỐ NGÀY -->

                <div class="ai-form-group">

                    <label>
                        📅 Bạn đi bao nhiêu ngày?
                    </label>

                    <input type="number"
                           name="days"
                           min="1"
                           max="30"
                           value="3"
                           required />

                </div>


                <!-- NGÂN SÁCH -->

                <div class="ai-form-group">

                    <label>
                        💰 Ngân sách dự kiến
                    </label>

                    <input type="number"
                           name="budget"
                           min="0"
                           step="100000"
                           placeholder="Ví dụ: 3000000" />

                    <small>
                        Nhập số tiền bằng VNĐ.
                    </small>

                </div>


                <!-- SỞ THÍCH -->

                <div class="ai-form-group">

                    <label>
                        ❤️ Bạn thích gì?
                    </label>

                    <select name="interest">

                        <option value="">
                            -- Chọn sở thích --
                        </option>

                        <option value="Biển">
                            🏖️ Biển
                        </option>

                        <option value="Núi">
                            🏔️ Núi
                        </option>

                        <option value="Thiên nhiên">
                            🌿 Thiên nhiên
                        </option>

                        <option value="Lịch sử">
                            🏛️ Lịch sử
                        </option>

                        <option value="Văn hóa">
                            🎎 Văn hóa
                        </option>

                        <option value="Ẩm thực">
                            🍜 Ẩm thực
                        </option>

                        <option value="Check-in">
                            📸 Check-in
                        </option>

                    </select>

                </div>


                <!-- BUTTON -->

                <button type="submit"
                        class="ai-submit-btn">

                    ✨ Tạo gợi ý du lịch

                </button>

            </form>

        </div>


        <!-- =========================
             INFO
             ========================= -->

        <div class="ai-info-grid">

            <div class="ai-info-card">

                <span>
                    🎯
                </span>

                <h3>
                    Cá nhân hóa
                </h3>

                <p>
                    Gợi ý dựa trên điểm đến,
                    thời gian và sở thích của bạn.
                </p>

            </div>


            <div class="ai-info-card">

                <span>
                    🗺️
                </span>

                <h3>
                    Gợi ý địa điểm
                </h3>

                <p>
                    Tìm những địa điểm phù hợp
                    từ dữ liệu TravelConnect.
                </p>

            </div>


            <div class="ai-info-card">

                <span>
                    📅
                </span>

                <h3>
                    Lập lịch trình
                </h3>

                <p>
                    Đề xuất cách phân bổ địa điểm
                    theo số ngày chuyến đi.
                </p>

            </div>

        </div>

    </div>

</section>


<style>

    .ai-page {
        padding: 50px 20px 80px;
        background: #f8fafc;
        min-height: 70vh;
    }


    .ai-container {
        max-width: 850px;
        margin: 0 auto;
    }


    /* =========================
           HERO
           ========================= */

    .ai-hero {
        text-align: center;
        margin-bottom: 35px;
    }


    .ai-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #ede9fe;
        font-size: 35px;
    }


    .ai-label {
        display: inline-block;
        margin-bottom: 10px;
        color: #7c3aed;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }


    .ai-hero h1 {
        margin: 0 0 12px;
        color: #222;
        font-size: 36px;
    }


    .ai-hero p {
        max-width: 600px;
        margin: 0 auto;
        color: #777;
        font-size: 15px;
        line-height: 1.7;
    }


    /* =========================
           ERROR
           ========================= */

    .ai-error {
        padding: 14px 16px;
        margin-bottom: 20px;
        border-radius: 10px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 14px;
    }


    /* =========================
           FORM CARD
           ========================= */

    .ai-form-card {
        padding: 30px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }


    .ai-form-group {
        margin-bottom: 20px;
    }


        .ai-form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-size: 14px;
            font-weight: 600;
        }


        .ai-form-group input,
        .ai-form-group select {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 14px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            outline: none;
            background: white;
            font-family: inherit;
            font-size: 14px;
        }


            .ai-form-group input:focus,
            .ai-form-group select:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 3px rgba(124,58,237,0.1);
            }


        .ai-form-group small {
            display: block;
            margin-top: 5px;
            color: #999;
            font-size: 12px;
        }


    /* =========================
           BUTTON
           ========================= */

    .ai-submit-btn {
        width: 100%;
        padding: 13px;
        margin-top: 5px;
        border: none;
        border-radius: 10px;
        background: #7c3aed;
        color: white;
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
        transition: 0.2s;
    }


        .ai-submit-btn:hover {
            background: #6d28d9;
            transform: translateY(-1px);
        }


    /* =========================
           INFO
           ========================= */

    .ai-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 25px;
    }


    .ai-info-card {
        padding: 20px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        text-align: center;
    }


        .ai-info-card span {
            font-size: 28px;
        }


        .ai-info-card h3 {
            margin: 10px 0 6px;
            color: #333;
            font-size: 16px;
        }


        .ai-info-card p {
            margin: 0;
            color: #888;
            font-size: 12px;
            line-height: 1.6;
        }


    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 700px) {

        .ai-page {
            padding: 35px 12px 60px;
        }


        .ai-hero h1 {
            font-size: 29px;
        }


        .ai-form-card {
            padding: 20px;
        }


        .ai-info-grid {
            grid-template-columns: 1fr;
        }
    }

</style>