@model TravelConnect.Models.Itinerary

@{
    ViewData["Title"] = "Tạo lịch trình";
}

<section class="create-itinerary-page">

    <div class="container">

        <div class="breadcrumb-custom">

            <a asp-controller="Home"
               asp-action="Index">
                Trang chủ
            </a>

            <span>›</span>

            <a asp-controller="Itinerary"
               asp-action="Index">
                Lịch trình
            </a>

            <span>›</span>

            <span>Tạo lịch trình</span>

        </div>


        <div class="create-itinerary-container">

            <div class="create-itinerary-heading">

                <span>🗓️ TRAVEL PLANNER</span>

                <h1>Tạo lịch trình mới</h1>

                <p>
                    Lên kế hoạch cho chuyến đi tiếp theo của bạn.
                </p>

            </div>


            <form asp-controller="Itinerary"
                  asp-action="Create"
                  method="post"
                  class="itinerary-form">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- Tên lịch trình -->

                <div class="form-group">

                    <label asp-for="Title">
                        Tên lịch trình
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Ví dụ: Khám phá Đà Nẵng 3 ngày 2 đêm" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                <!-- Mô tả -->

                <div class="form-group">

                    <label asp-for="Description">
                        Mô tả chuyến đi
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Mô tả ngắn về chuyến đi của bạn...">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Ngày -->

                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="StartDate">
                            Ngày bắt đầu
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="EndDate">
                            Ngày kết thúc
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Trạng thái -->

                <div class="form-group">

                    <label class="public-checkbox">

                        <input asp-for="IsPublic" />

                        <span>
                            🌎 Công khai lịch trình
                        </span>

                    </label>

                    <small>
                        Lịch trình công khai có thể được cộng đồng
                        TravelConnect xem.
                    </small>

                </div>


                <!-- Buttons -->

                <div class="form-actions">

                    <a asp-controller="Itinerary"
                       asp-action="Index"
                       class="cancel-itinerary-btn">
                        Hủy
                    </a>

                    <button type="submit"
                            class="save-itinerary-btn">
                        🗓️ Tạo lịch trình
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}