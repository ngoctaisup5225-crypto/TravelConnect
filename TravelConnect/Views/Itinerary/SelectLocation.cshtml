@model List<TravelConnect.Models.Location>

@{
    var itinerary =
        ViewBag.Itinerary as TravelConnect.Models.Itinerary;

    ViewData["Title"] = "Chọn địa điểm";
}

<div class="select-location-page">

    <div class="select-location-container">

        <!-- Breadcrumb -->

        <div class="breadcrumb-custom">

            <a asp-controller="Home"
               asp-action="Index">
                Trang chủ
            </a>

            <span>›</span>

            <a asp-controller="Itinerary"
               asp-action="Index">
                Lịch trình
            </a>

            <span>›</span>

            <span>Chọn địa điểm</span>

        </div>


        <!-- Header -->

        <div class="select-location-header">

            <div>

                <span class="select-location-label">
                    🗓️ @itinerary?.Title
                </span>

                <h1>
                    Chọn địa điểm
                </h1>

                <p>
                    Chọn địa điểm muốn thêm vào lịch trình của bạn.
                </p>

            </div>


            <a asp-controller="Itinerary"
               asp-action="Details"
               asp-route-id="@itinerary?.Id"
               class="back-itinerary-btn">
                ← Quay lại lịch trình
            </a>

        </div>


        <!-- Danh sách địa điểm -->
        @if (Model.Any())
        {
            <div class="select-location-grid">

                @foreach (var location in Model)
                {
                    <div class="select-location-card">

                        <div class="select-location-image">

                            @if (!string.IsNullOrWhiteSpace(location.Image))
                            {
                                <img src="@location.Image"
                                     alt="@location.Name" />
                            }
                            else
                            {
                                <div class="no-location-image">
                                    📍
                                </div>
                            }

                        </div>


                        <div class="select-location-content">

                            <span class="location-category">
                                @location.Category
                            </span>


                            <h2>
                                @location.Name
                            </h2>


                            <p class="location-province">
                                📍 @location.Province
                            </p>


                            <div class="location-rating">
                                ⭐ @location.Rating.ToString("0.0")
                            </div>


                            <p class="location-description">
                                @location.Description
                            </p>


                            <a asp-controller="Itinerary"
                               asp-action="AddLocationForm"
                               asp-route-itineraryId="@itinerary?.Id"
                               asp-route-locationId="@location.Id"
                               class="select-location-btn">
                                + Thêm vào lịch trình
                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="no-locations">

                <div>
                    🗺️
                </div>

                <h2>
                    Chưa có địa điểm
                </h2>

                <p>
                    Hệ thống hiện chưa có địa điểm nào.
                </p>

            </div>
        }

    </div>

</div>


<style>

    .select-location-page {
        padding: 35px 20px 70px;
    }


    .select-location-container {
        max-width: 1200px;
        margin: 0 auto;
    }


    .select-location-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin: 25px 0 30px;
    }


    .select-location-label {
        display: inline-block;
        margin-bottom: 10px;
        padding: 6px 12px;
        border-radius: 20px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 13px;
        font-weight: 600;
    }


    .select-location-header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        color: #222;
    }


    .select-location-header p {
        margin: 0;
        color: #777;
    }


    .back-itinerary-btn {
        padding: 11px 17px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #334155;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }


        .back-itinerary-btn:hover {
            background: #e2e8f0;
        }


    .select-location-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }


    .select-location-card {
        overflow: hidden;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        transition: 0.2s;
    }


        .select-location-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }


    .select-location-image {
        height: 190px;
        background: #f1f5f9;
        overflow: hidden;
    }


        .select-location-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .no-location-image {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 45px;
    }


    .select-location-content {
        padding: 18px;
    }


    .location-category {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 11px;
        font-weight: 700;
    }


    .select-location-content h2 {
        margin: 10px 0 6px;
        font-size: 20px;
        color: #222;
    }


    .location-province {
        margin: 0 0 7px;
        color: #666;
        font-size: 13px;
    }


    .location-rating {
        margin-bottom: 10px;
        color: #d97706;
        font-size: 13px;
        font-weight: 600;
    }


    .location-description {
        min-height: 48px;
        margin: 0 0 15px;
        color: #777;
        font-size: 13px;
        line-height: 1.6;
    }


    .select-location-btn {
        display: block;
        padding: 11px;
        border-radius: 10px;
        background: #2563eb;
        color: white;
        text-align: center;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }


        .select-location-btn:hover {
            background: #1d4ed8;
            color: white;
        }


    .no-locations {
        padding: 70px 20px;
        text-align: center;
        color: #888;
    }


        .no-locations > div {
            font-size: 45px;
            margin-bottom: 10px;
        }


        .no-locations h2 {
            margin: 0 0 8px;
            color: #444;
        }


        .no-locations p {
            margin: 0;
        }


    @@media (max-width: 900px) {

        .select-location-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 600px) {

        .select-location-page {
            padding: 25px 12px 50px;
        }

        .select-location-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .select-location-header h1 {
                font-size: 26px;
            }

        .back-itinerary-btn {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

        .select-location-grid {
            grid-template-columns: 1fr;
        }
    }

</style>