@model List<TravelConnect.Models.Comment>

@{
    ViewData["Title"] = "Quản lý bình luận";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <h1>💬 Quản lý bình luận</h1>
            <p>Quản lý các bình luận được đăng trong cộng đồng.</p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="admin-back-btn">
            ← Dashboard
        </a>
    </div>


    <div class="admin-table-card">

        <div class="admin-table-header">
            <div>
                <strong>Danh sách bình luận</strong>

                <span class="admin-count">
                    @Model.Count bình luận
                </span>
            </div>
        </div>


        @if (Model.Any())
        {
            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Người dùng</th>
                            <th>Nội dung</th>
                            <th>Bài viết</th>
                            <th>Thời gian</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var comment in Model)
                        {
                            <tr>

                                <td>
                                    #@comment.Id
                                </td>

                                <td>
                                    <strong>
                                        @comment.UserName
                                    </strong>
                                </td>

                                <td>
                                    <div class="comment-text-admin">
                                        @comment.Content
                                    </div>
                                </td>

                                <td>
                                    <span class="post-id-badge">
                                        #@comment.PostId
                                    </span>
                                </td>

                                <td>
                                    @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>

                                    <div class="admin-actions">

                                        <a asp-controller="Post"
                                           asp-action="Details"
                                           asp-route-id="@comment.PostId"
                                           class="admin-view-btn">
                                            👁️ Xem
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="DeleteComment"
                                           asp-route-id="@comment.Id"
                                           class="admin-delete-btn"
                                           onclick="return confirm('Bạn có chắc muốn xóa bình luận này?');">
                                            🗑️ Xóa
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="admin-empty">

                <div>💬</div>

                <h3>Chưa có bình luận</h3>

                <p>Hiện tại chưa có bình luận nào trong hệ thống.</p>

            </div>
        }

    </div>

</div>


<style>

    .admin-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 35px 20px 70px;
    }

    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

        .admin-page-header h1 {
            margin: 0 0 7px;
            font-size: 28px;
            color: #222;
        }

        .admin-page-header p {
            margin: 0;
            color: #777;
            font-size: 14px;
        }

    .admin-back-btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #334155;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

        .admin-back-btn:hover {
            background: #e2e8f0;
        }

    .admin-table-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
    }

    .admin-table-header {
        padding: 20px 22px;
        border-bottom: 1px solid #eee;
    }

        .admin-table-header > div {
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .admin-count {
        padding: 4px 10px;
        border-radius: 20px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 700;
    }

    .admin-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

        .admin-table th {
            padding: 14px 16px;
            text-align: left;
            background: #f8fafc;
            color: #64748b;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .admin-table td {
            padding: 15px 16px;
            border-top: 1px solid #eee;
            color: #444;
            font-size: 14px;
            vertical-align: middle;
        }

        .admin-table tbody tr:hover {
            background: #fafafa;
        }

    .comment-text-admin {
        max-width: 400px;
        line-height: 1.5;
        word-break: break-word;
    }

    .post-id-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475569;
        font-size: 12px;
        font-weight: 600;
    }

    .admin-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .admin-view-btn {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 8px;
        background: #eff6ff;
        color: #2563eb;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .admin-view-btn:hover {
            background: #dbeafe;
        }

    .admin-delete-btn {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 8px;
        background: #fef2f2;
        color: #dc2626;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .admin-delete-btn:hover {
            background: #fee2e2;
        }

    .admin-empty {
        text-align: center;
        padding: 60px 20px;
        color: #888;
    }

        .admin-empty > div {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .admin-empty h3 {
            margin: 0 0 5px;
            color: #444;
        }

        .admin-empty p {
            margin: 0;
            font-size: 14px;
        }


    @@media (max-width: 600px) {

        .admin-page {
            padding: 25px 12px 50px;
        }

        .admin-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .admin-page-header h1 {
                font-size: 24px;
            }

        .admin-back-btn {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }
    }

</style>